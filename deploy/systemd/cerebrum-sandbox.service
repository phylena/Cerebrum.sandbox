# Run the controller directly on the host (alternative to docker compose).
#   useradd --system --home /var/lib/cerebrum-sandbox --groups docker,kvm cerebrum-sandbox
#   python3 -m venv /opt/cerebrum-sandbox && /opt/cerebrum-sandbox/bin/pip install /path/to/Cerebrum.sandbox
# Membership of the docker group is root-equivalent: this account must run nothing else.
[Unit]
Description=Cerebrum.sandbox controller
After=docker.service network-online.target
Requires=docker.service

[Service]
User=cerebrum-sandbox
EnvironmentFile=/etc/cerebrum-sandbox/env
Environment=SANDBOX_DATA_DIR=/var/lib/cerebrum-sandbox
ExecStart=/opt/cerebrum-sandbox/bin/python -m cerebrum_sandbox
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cerebrum-sandbox
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
