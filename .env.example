# One key per role (openssl rand -hex 32). Cerebrum.model gets the OPERATOR key. No keys = API refuses everything.
SANDBOX_ADMIN_KEY=
SANDBOX_OPERATOR_KEY=
SANDBOX_VIEWER_KEY=
SANDBOX_DATA_DIR=./data
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=8300
# Ceilings (defaults suit a 4 vCPU / 16 GB host)
SANDBOX_MAX_SANDBOXES=8
SANDBOX_MAX_TOTAL_CPU=3
SANDBOX_MAX_TOTAL_MEMORY_MB=12288
SANDBOX_MAX_EXEC_SECONDS=600
# gVisor runtime name (profiles with isolation=gvisor) and the egress network/proxy for allowlist profiles.
SANDBOX_GVISOR_RUNTIME=runsc
SANDBOX_EGRESS_NETWORK=
SANDBOX_EGRESS_PROXY_URL=

# ---- Runtimes (which isolation levels this node offers) ----
# docker = hardened container, gvisor = container under runsc, firecracker = microVM (needs /dev/kvm)
SANDBOX_RUNTIMES=docker
# Weakest isolation allowed here; weaker profiles are upgraded to it (container | gvisor | microvm)
SANDBOX_MIN_ISOLATION=container
# Firecracker (see images/firecracker/build-rootfs.sh)
SANDBOX_FC_BIN=firecracker
SANDBOX_FC_KERNEL=
SANDBOX_FC_ROOTFS=
SANDBOX_FC_DIR=/var/lib/cerebrum-sandbox/fc
# GPUs: restrict usable host GPU indices (empty = all) and cap concurrent GPU sandboxes
SANDBOX_GPU_INDICES=
SANDBOX_MAX_GPU_SANDBOXES=2
# Worker fleet
SANDBOX_MAX_WORKERS=16
